#!/usr/bin/env bash
# cfb-cut file1 [file2 ...]
# puts file(s) on the clipboard as a "cut" operation, GUI-file-manager style.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=../lib/cfb-library.sh
source "$script_dir/../lib/cfb-library.sh"

cfb_mark "cut" "$@"
